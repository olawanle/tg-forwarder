FROM python:3.12-slim

WORKDIR /app

COPY requirements-forwarder.txt ./
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements-forwarder.txt

COPY forwarder ./forwarder

# Use /app/data by default so the app works even without a Railway volume.
# If you attach a volume, mount it at /data and set FORWARDER_DATA_DIR=/data.
ENV PYTHONUNBUFFERED=1 \
    FORWARDER_DATA_DIR=/app/data \
    STREAMLIT_SERVER_ADDRESS=0.0.0.0 \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

RUN mkdir -p /app/data

# Railway injects PORT. Expand it in a shell so Streamlit gets a real integer.
CMD ["sh", "-c", "mkdir -p \"${FORWARDER_DATA_DIR:-/app/data}\" && exec streamlit run forwarder/app.py --server.port=${PORT:-8080} --server.address=0.0.0.0 --server.headless=true --server.enableCORS=false --server.enableXsrfProtection=false"]
