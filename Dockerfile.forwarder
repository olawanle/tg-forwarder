FROM python:3.12-slim

WORKDIR /app

COPY requirements-forwarder.txt ./
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements-forwarder.txt

COPY forwarder ./forwarder

ENV PYTHONUNBUFFERED=1 \
    FORWARDER_DATA_DIR=/data

CMD streamlit run forwarder/app.py --server.port=$PORT --server.address=0.0.0.0 --server.headless=true
