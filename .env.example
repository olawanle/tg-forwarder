APP_NAME=Telegram Campaign Manager
ENVIRONMENT=production
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://campaign:campaign@localhost:5432/campaign
REDIS_URL=redis://localhost:6379/0
BOT_TOKEN=123456:replace-with-botfather-token
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_MINUTES=10080
FERNET_KEY=replace-with-python-cryptography-fernet-key
ADMIN_TELEGRAM_IDS=123456789
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
DEFAULT_ACCOUNT_DAILY_LIMIT=250
DEFAULT_ACCOUNT_HOURLY_LIMIT=40
DEFAULT_MIN_DELAY_SECONDS=45
DEFAULT_MAX_DELAY_SECONDS=180
